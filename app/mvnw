# ----------------------------------------------------------------------------
# Apache Maven Wrapper startup batch script, version 3.2.0
#
# Optional ENV vars:
# JAVA_HOME - location of a JDK home dir
# MAVEN_OPTS - parameters passed to the Java VM when running Maven
#   e.g. to debug Maven itself, use
#     set MAVEN_OPTS=-Xdebug -Xrunjdwp:transport=dt_socket,server=y,suspend=y,address=8000
# MAVEN_SKIP_RC - flag to disable loading of mavenrc files
# ----------------------------------------------------------------------------

if [ -z "$MAVEN_SKIP_RC" ] ; then
  if [ -f /usr/local/etc/mavenrc ] ; then
    . /usr/local/etc/mavenrc
  fi
  if [ -f /etc/mavenrc ] ; then
    . /etc/mavenrc
  fi
  if [ -f "$HOME/.mavenrc" ] ; then
    . "$HOME/.mavenrc"
  fi
fi

# OS specific support.  $var _must_ be set to either true or false.
cygwin=false;
darwin=false;
mingw=false
case "$(uname)" in
  CYGWIN*) cygwin=true ;;
  MINGW*) mingw=true;;
  Darwin*) darwin=true
    # Use /usr/libexec/java_home if available, otherwise fall through
    # see https://developer.apple.com/library/mac/qa/qa1170/_index.html
    if [ -z "$JAVA_HOME" ]; then
      if [ -x "/usr/libexec/java_home" ]; then
        JAVA_HOME="$(/usr/libexec/java_home)"; export JAVA_HOME
      fi
    fi
    ;;
esac

if [ -z "$JAVA_HOME" ] ; then
  if [ -r /etc/gentoo-release ] ; then
    JAVA_HOME=$(java-config --jre-home)
  fi
fi

# For Cygwin, ensure paths are in UNIX format before anything is touched
if $cygwin ; then
  [ -n "$JAVA_HOME" ] &&
    JAVA_HOME=$(cygpath --unix "$JAVA_HOME")
  [ -n "$CLASSPATH" ] &&
    CLASSPATH=$(cygpath --path --unix "$CLASSPATH")
fi

# For Mingw, ensure paths are in UNIX format before anything is touched
if $mingw ; then
  [ -n "$JAVA_HOME" ] && [ -d "$JAVA_HOME" ] &&
    JAVA_HOME="$(cd "$JAVA_HOME" || (echo "cannot cd into $JAVA_HOME."; exit 1); pwd)"
fi

if [ -z "$JAVA_HOME" ]; then
  javaExecutable="$(which javac)"
  if [ -n "$javaExecutable" ] && ! [ "$(expr "$javaExecutable" : '\([^ ]*\)')" = "no" ]; then
    # readlink(1) is not available as standard on Solaris 10.
    readLink=$(which readlink)
    if [ ! "$(expr "$readLink" : '\([^ ]*\)')" = "no" ]; then
      if $darwin ; then
        javaHome="$(dirname "$javaExecutable")"
        javaExecutable="$(readlink "$javaHome")"
        case "$javaExecutable" in
          /*) ;;
          *) javaExecutable="$javaHome/$javaExecutable" ;;
        esac
        javaHome="$(dirname "$javaExecutable")"
      else
        javaHome="$(dirname "$javaExecutable")"
        javaHome=$(readlink -f "$javaHome")
      fi
      javaHome=$(expr "$javaHome" : '\(.*\)/bin')
      JAVA_HOME="$javaHome"
      export JAVA_HOME
    fi
  fi
fi

if [ -z "$MVNW_VERBOSE" ]; then
  MVNW_VERBOSE=false
fi

# Calculate the project base directory, i.e. the directory that contains the folder ".mvn".
# Fallback to current directory if not found.
find_maven_basedir() {
  if [ -z "$1" ]
  then
    echo "Path not specified to find_maven_basedir"
    return 1
  fi

  basedir="$1"
  wdir="$1"
  while [ "$wdir" != '/' ] ; do
    if [ -d "$wdir"/.mvn ] ; then
      basedir=$wdir
      break
    fi
    # workaround for JBEAP-8937 (on Solaris 10/Sparc)
    if [ -d "${wdir}" ]; then
      wdir=$(cd "$wdir/.." || exit 1; pwd)
    fi
    # end workaround
  done
  printf '%s' "$(cd "$basedir" || exit 1; pwd)"
}

# concatenates all lines of a file
concat_lines() {
  if [ -f "$1" ]; then
    # Remove \r in case we run on Windows within Git Bash
    # and check the file is not empty
    tr -s '\r\n' ' ' < "$1"
  fi
}

log() {
  if [ "$MVNW_VERBOSE" = true ]; then
    printf '%s\n' "$1"
  fi
}

BASE_DIR=$(find_maven_basedir "$(dirname "$0")")
if [ -z "$BASE_DIR" ]; then
  exit 1;
fi

MAVEN_PROJECTBASEDIR=${MAVEN_BASEDIR:-"$BASE_DIR"}
export MAVEN_PROJECTBASEDIR
log "$MAVEN_PROJECTBASEDIR"

##########################################################################################
# Download Maven distribution if needed
##########################################################################################
distributionUrl=""
while IFS="=" read -r key value; do
  key=$(echo "$key" | tr -d '\r')
  value=$(echo "$value" | tr -d '\r')
  case "$key" in
    distributionUrl) distributionUrl="$value"; break ;;
  esac
done < "$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.properties"

if [ -z "$distributionUrl" ]; then
  echo "ERROR: distributionUrl not found in .mvn/wrapper/maven-wrapper.properties"
  exit 1
fi

# Compute the distribution name and directory
distributionName="$(echo "$distributionUrl" | sed 's|.*/||')"
distributionBase="${distributionName%.zip}"

# Local cache directory
DISTRIBUTION_DIR="$HOME/.m2/wrapper/dists/$distributionBase"

MAVEN_HOME=""
if [ -d "$DISTRIBUTION_DIR" ]; then
  # Find the extracted directory
  for d in "$DISTRIBUTION_DIR"/*/; do
    if [ -f "$d/bin/mvn" ]; then
      MAVEN_HOME="$d"
      break
    fi
  done
fi

if [ -z "$MAVEN_HOME" ]; then
  mkdir -p "$DISTRIBUTION_DIR"
  log "Downloading Maven from $distributionUrl"
  zipFile="$DISTRIBUTION_DIR/$distributionName"

  if command -v curl > /dev/null; then
    curl -s -o "$zipFile" "$distributionUrl"
  elif command -v wget > /dev/null; then
    wget -q -O "$zipFile" "$distributionUrl"
  else
    echo "ERROR: Neither curl nor wget found. Cannot download Maven."
    exit 1
  fi

  log "Extracting Maven..."
  unzip -q "$zipFile" -d "$DISTRIBUTION_DIR"
  rm -f "$zipFile"

  for d in "$DISTRIBUTION_DIR"/*/; do
    if [ -f "$d/bin/mvn" ]; then
      MAVEN_HOME="$d"
      break
    fi
  done
fi

if [ -z "$MAVEN_HOME" ]; then
  echo "ERROR: Could not find Maven installation in $DISTRIBUTION_DIR"
  exit 1
fi

MAVEN_OPTS="$(concat_lines "$MAVEN_PROJECTBASEDIR/.mvn/jvm.config") $MAVEN_OPTS"

# For Cygwin, switch paths to Windows format before running java
if $cygwin; then
  [ -n "$JAVA_HOME" ] &&
    JAVA_HOME=$(cygpath --path --windows "$JAVA_HOME")
  [ -n "$HOME" ] &&
    HOME=$(cygpath --path --windows "$HOME")
  [ -n "$MAVEN_PROJECTBASEDIR" ] &&
    MAVEN_PROJECTBASEDIR=$(cygpath --path --windows "$MAVEN_PROJECTBASEDIR")
  [ -n "$MAVEN_HOME" ] &&
    MAVEN_HOME=$(cygpath --path --windows "$MAVEN_HOME")
fi

export MAVEN_CMD_LINE_ARGS="$MAVEN_CONFIG $*"

exec "${MAVEN_HOME}bin/mvn" $MAVEN_OPTS -Dmaven.multiModuleProjectDirectory="$MAVEN_PROJECTBASEDIR" $MAVEN_CONFIG "$@"
